{
  "name": "khoai-lang-graph",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-22-bookworm",
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb"
  },
  "features": {
    "ghcr.io/devcontainers/features/python:1": { "version": "3.12" },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [3000, 8000],
  "portsAttributes": {
    "3000": {
      "label": "Next dev server",
      "onAutoForward": "silent"
    },
    "8000": {
      "label": "API server",
      "onAutoForward": "silent"
    }
  },
  "onCreateCommand": "sudo corepack enable && pipx install uv && pipx install rust-just",
  // Runs after creation and again whenever the repo content is updated (prebuilds), so a
  // changed lockfile is picked up without a manual install.
  "updateContentCommand": "cd frontend && pnpm install --frozen-lockfile",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "ms-python.mypy-type-checker",
        "skellock.just",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "github.vscode-github-actions",
        "matt-meyers.vscode-dbml",
        "hediet.vscode-drawio"
      ],
      "settings": {
        "[javascript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
        "[javascriptreact]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
        "[typescript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
        "[typescriptreact]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
        "[python]": { "editor.defaultFormatter": "charliermarsh.ruff" },
        "[html]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
        "[markdown]": { "editor.defaultFormatter": "esbenp.prettier-vscode", "editor.tabSize": 2 },

        // Build output and reports are never edited by hand: keep them out of the file watcher,
        // search index, and Explorer.
        "files.watcherExclude": {
          "**/.next/**": true,
          "**/node_modules/**": true,
          "**/test-results/**": true,
          "**/playwright-report/**": true,
          "**/coverage/**": true
        },
        "search.exclude": {
          "**/.next": true,
          "**/node_modules": true,
          "**/test-results": true,
          "**/playwright-report": true,
          "**/coverage": true,
          "**/pnpm-lock.yaml": true,
          "frontend/src/api/generated": true
        },
        "files.exclude": { "**/.next": true },

        // Tailwind IntelliSense: use the one stylesheet instead of scanning the workspace.
        "tailwindCSS.experimental.configFile": "frontend/src/app/styles.css",
        "tailwindCSS.files.exclude": [
          "**/.git/**",
          "**/node_modules/**",
          "**/.next/**",
          "**/test-results/**",
          "**/playwright-report/**"
        ],

        "typescript.disableAutomaticTypeAcquisition": true,

        // ESLint runs from frontend/ with the editor config, which leaves out the type-aware
        // rules. `pnpm lint` still runs all rules.
        "eslint.workingDirectories": [{ "directory": "frontend", "changeProcessCWD": true }],
        "eslint.options": { "overrideConfigFile": "eslint.editor.config.js" }
      }
    }
  }
}
