# Copy to .env.local (git-ignored). NEXT_PUBLIC_* variables are inlined into the
# browser bundle; never put secrets in them.

# `enabled` serves the API from MSW mocks (src/mocks/) so the UI runs without the backend.
NEXT_PUBLIC_API_MOCKING=disabled

# Origin that /api requests are proxied to by the Next.js server (not exposed to the browser).
API_PROXY_TARGET=http://localhost:8000

# Address of a trace viewer. A run with a trace id links to <address>/<trace id> in the workflow
# view; without it the trace id is shown as text.
# NEXT_PUBLIC_TRACE_URL=http://localhost:3001/trace
