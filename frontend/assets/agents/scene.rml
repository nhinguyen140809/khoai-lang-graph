        <StateMachine name="Face" id="0:900">
            <StateMachineLayer name="Blink" id="0:901">
                <AnyState x="200" y="-120"/>
                <ExitState x="400" y="-120"/>
                <EntryState>
                    <StateTransition stateToId="0:902"/>
                </EntryState>
                <AnimationState x="200" animationId="0:90" id="0:902"/>
            </StateMachineLayer>
        </StateMachine>

        <!-- The blink loops by itself; every other move of the eyes comes from the data. -->
        <LinearAnimation loopValue="loop" duration="240" name="Blink" id="0:90">
            <KeyedObject objectId="0:22">
                <KeyedProperty property="scaleY">
                    <KeyFrameDouble value="1" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="1" frame="226" interpolationType="linear"/>
                    <KeyFrameDouble value="0.08" frame="232" interpolationType="linear"/>
                    <KeyFrameDouble value="1" frame="240" interpolationType="linear"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:25">
                <KeyedProperty property="scaleY">
                    <KeyFrameDouble value="1" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="1" frame="226" interpolationType="linear"/>
                    <KeyFrameDouble value="0.08" frame="232" interpolationType="linear"/>
                    <KeyFrameDouble value="1" frame="240" interpolationType="linear"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>
    </Artboard>

    <!-- A bound position replaces the authored one, so each range is centered on the rest place of what it moves. A look of 1 is a unit of the face, 8 px; the range is 6 units to a side. -->
    <DataConverterRangeMapper minInput="-6" maxInput="6" minOutput="112" maxOutput="208" clampLower="true" clampUpper="true" name="LookToX" id="0:50"/>
    <DataConverterRangeMapper minInput="-6" maxInput="6" minOutput="112" maxOutput="208" clampLower="true" clampUpper="true" name="LookToY" id="0:51"/>
    <!-- The gap is the distance of an eye from the middle, in px: the left eye is at minus that, the right one at plus that. -->
    <DataConverterRangeMapper minInput="0" maxInput="100" minOutput="0" maxOutput="-100" name="GapToLeft" id="0:52"/>
    <DataConverterRangeMapper minInput="0" maxInput="100" minOutput="0" maxOutput="100" name="GapToRight" id="0:53"/>

    <!-- A change of size or lean eases over motionSeconds, and lands at once when that is 0, which is what a user who asked for less motion gets. -->
    <DataConverterInterpolator interpolationType="cubic" name="Ease" id="0:60">
        <DataBindContext sourcePathIds="0:700-0:726" propertyKey="756"/>
        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/>
    </DataConverterInterpolator>
    <DataConverterSystemDegsToRads operationType="2" operationValue="0.017453292" name="DegreesToRadians" id="0:62"/>
    <DataConverterGroup name="EaseTilt" id="0:61">
        <DataConverterGroupItem converterId="0:60"/>
        <DataConverterGroupItem converterId="0:62"/>
    </DataConverterGroup>

