{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "items/spec_requirement/v1",
  "title": "Requirement",
  "description": "A requirement as written in the specification.",
  "x-level": "item",
  "x-kind": "spec_requirement",
  "x-schema-version": 1,
  "x-key-prefix": "REQ",
  "x-ui-display": "table",
  "x-ui-navigable": true,
  "x-ui-title-field": "title",
  "x-ui-list-fields": [
    "title",
    "type",
    "priority",
    "verification_method"
  ],
  "x-ui-field-order": [
    "title",
    "statement",
    "type",
    "quality_category",
    "priority",
    "rationale",
    "acceptance_criteria",
    "fit_criterion",
    "verification_method"
  ],
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "title": {
      "title": "Title",
      "type": "string",
      "description": "Short name, for example \"Search mentors\".",
      "x-ui-widget": "text"
    },
    "statement": {
      "title": "Statement",
      "type": "string",
      "description": "The requirement, in the form \"The system shall ...\".",
      "x-ui-widget": "textarea"
    },
    "type": {
      "title": "Type",
      "type": "string",
      "enum": [
        "functional",
        "non_functional",
        "constraint"
      ],
      "description": "Kind of requirement.",
      "x-ui-widget": "select"
    },
    "quality_category": {
      "title": "Quality category",
      "type": [
        "string",
        "null"
      ],
      "x-value-list": "quality_category",
      "description": "Quality attribute. Required when type is non_functional, null otherwise.",
      "x-ui-widget": "select"
    },
    "priority": {
      "title": "Priority",
      "type": "string",
      "x-value-list": "priority",
      "description": "Importance.",
      "x-ui-widget": "select"
    },
    "rationale": {
      "title": "Rationale",
      "type": "string",
      "description": "Why the requirement exists.",
      "x-ui-widget": "textarea"
    },
    "acceptance_criteria": {
      "title": "Acceptance criteria",
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Conditions that show a functional requirement is met.",
      "x-ui-widget": "list"
    },
    "fit_criterion": {
      "title": "Fit criterion",
      "type": [
        "string",
        "null"
      ],
      "description": "Measurable threshold. Required when type is non_functional, null otherwise.",
      "x-ui-widget": "textarea"
    },
    "verification_method": {
      "title": "Verification method",
      "type": "string",
      "enum": [
        "test",
        "inspection",
        "demonstration",
        "analysis"
      ],
      "description": "How the requirement is verified.",
      "x-ui-widget": "select"
    }
  },
  "required": [
    "title",
    "statement",
    "type",
    "quality_category",
    "priority",
    "rationale",
    "acceptance_criteria",
    "fit_criterion",
    "verification_method"
  ]
}
