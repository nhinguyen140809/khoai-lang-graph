{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "items/raw_requirement/v1",
  "title": "Stated need",
  "description": "A requirement as stated in an interview, before any rewriting.",
  "x-level": "item",
  "x-kind": "raw_requirement",
  "x-schema-version": 1,
  "x-key-prefix": "RAW",
  "x-ui-display": "table",
  "x-ui-title-field": "statement",
  "x-ui-list-fields": [
    "statement",
    "topic"
  ],
  "x-ui-field-order": [
    "statement",
    "topic"
  ],
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "statement": {
      "title": "Statement",
      "type": "string",
      "description": "The requirement, close to the persona's own words.",
      "x-ui-widget": "textarea"
    },
    "topic": {
      "title": "Topic",
      "type": [
        "string",
        "null"
      ],
      "x-value-from": "elicitation_plan.topics",
      "description": "The plan topic it belongs to.",
      "x-ui-widget": "select"
    }
  },
  "required": [
    "statement",
    "topic"
  ]
}
