{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "items/persona/v2",
  "title": "Interviewee",
  "description": "A simulated interviewee, grounded in evidence mined from research documents.",
  "x-level": "item",
  "x-kind": "persona",
  "x-schema-version": 2,
  "x-key-prefix": "PER",
  "x-ui-display": "profile",
  "x-ui-navigable": true,
  "x-ui-title-field": "name",
  "x-ui-list-fields": [
    "name",
    "stakeholder_type",
    "interview_status",
    "background",
    "goals"
  ],
  "x-ui-field-order": [
    "name",
    "stakeholder_type",
    "evaluative_dimension",
    "grounded_in",
    "background",
    "expertise",
    "goals",
    "interests",
    "constraints",
    "priorities",
    "concerns",
    "behavioral_tendencies",
    "evidence",
    "interview_status"
  ],
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "title": "Name",
      "type": "string",
      "description": "Display name, for example \"Minh, 3rd-year CS student\".",
      "x-ui-widget": "text"
    },
    "stakeholder_type": {
      "title": "Stakeholder type",
      "type": "string",
      "x-value-from": "elicitation_plan.stakeholder_types",
      "description": "One of the stakeholder types of the elicitation plan.",
      "x-ui-widget": "select"
    },
    "evaluative_dimension": {
      "title": "Judges the product by",
      "type": "string",
      "description": "The dimension this interviewee evaluates the product by, distilled from the evidence found.",
      "x-ui-widget": "text"
    },
    "grounded_in": {
      "title": "Based on",
      "type": "array",
      "description": "The keys of the stakeholder observations this interviewee is built from.",
      "x-ui-widget": "list",
      "items": {
        "type": "string"
      }
    },
    "background": {
      "title": "Background",
      "type": "string",
      "description": "History, context, situation.",
      "x-ui-widget": "textarea"
    },
    "expertise": {
      "title": "Expertise",
      "type": "string",
      "description": "Technical and domain familiarity.",
      "x-ui-widget": "textarea"
    },
    "goals": {
      "title": "Goals",
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "What this persona wants the system to do.",
      "x-ui-widget": "list"
    },
    "interests": {
      "title": "Interests",
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "What they care about.",
      "x-ui-widget": "list"
    },
    "constraints": {
      "title": "Constraints",
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Limits they operate under.",
      "x-ui-widget": "list"
    },
    "priorities": {
      "title": "Priorities",
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "How they rank their interests, most important first.",
      "x-ui-widget": "list"
    },
    "concerns": {
      "title": "Concerns",
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Risks, worries, objections.",
      "x-ui-widget": "list"
    },
    "behavioral_tendencies": {
      "title": "Behavioral tendencies",
      "type": "string",
      "description": "How they tend to communicate.",
      "x-ui-widget": "textarea"
    },
    "evidence": {
      "title": "Evidence",
      "type": "array",
      "description": "The words of the research documents that support this interviewee, each with the observation and the document it comes from.",
      "x-ui-widget": "list",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "observation": {
            "type": "string",
            "description": "Key of the stakeholder observation."
          },
          "source": {
            "type": "string",
            "description": "Key of the research document the quote comes from."
          },
          "quote": {
            "type": "string",
            "description": "The exact sentence mined from the document, copied unchanged."
          }
        },
        "required": [
          "observation",
          "source",
          "quote"
        ]
      }
    },
    "interview_status": {
      "title": "Interview status",
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "completed"
      ],
      "description": "Progress of the interview with this persona. Set by the system.",
      "x-ui-widget": "badge",
      "readOnly": true
    }
  },
  "required": [
    "name",
    "stakeholder_type",
    "evaluative_dimension",
    "grounded_in",
    "background",
    "expertise",
    "goals",
    "interests",
    "constraints",
    "priorities",
    "concerns",
    "behavioral_tendencies",
    "evidence",
    "interview_status"
  ]
}
