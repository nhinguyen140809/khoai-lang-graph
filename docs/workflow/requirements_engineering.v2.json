  "run_parameters_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "target_personas_num": {
        "type": "integer",
        "title": "Number of interviewees",
        "minimum": 1,
        "maximum": 10,
        "default": 3,
        "description": "How many interviewees take part in the interviews."
      },
      "max_personas": {
        "type": "integer",
        "title": "Maximum interviewees",
        "minimum": 1,
        "maximum": 10,
        "default": 3,
        "description": "The largest number of interviewees who may be interviewed. It should not be lower than the number of interviewees above."
      },
      "max_turns": {
        "type": "integer",
        "title": "Maximum turns per interviewee",
        "minimum": 1,
        "maximum": 20,
        "default": 6,
        "description": "The longest an interview may run, counted in questions and answers."
      },
      "max_iterations": {
        "type": "integer",
        "title": "Maximum review rounds",
        "minimum": 0,
        "maximum": 5,
        "default": 2,
        "description": "How many times the results may be revised after a review."
      },
      "target_sources_num": {
        "type": "integer",
        "title": "Number of research documents",
        "minimum": 1,
        "maximum": 10,
        "default": 3,
        "description": "How many documents the research keeps as evidence."
      }
    },
    "required": [
      "target_personas_num",
      "max_personas",
      "max_turns",
      "max_iterations"
    ]
  },
  "state_schema": {
    "type": "object",
    "description": "The workflow state holds references, not copies: artifacts and items appear at the version the step used.",
    "additionalProperties": false,
    "$defs": {
      "itemRef": {
        "type": "object",
        "additionalProperties": false,
        "description": "An item at the version the step used.",
        "properties": {
          "item_id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "item_id",
          "kind",
          "key",
          "version"
        ]
      },
      "artifactRef": {
        "type": "object",
        "additionalProperties": false,
        "description": "An artifact at the version the step used.",
        "properties": {
          "artifact_id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "artifact_id",
          "kind",
          "title",
          "version"
        ]
      }
    },
    "properties": {
      "project_id": {
        "type": "string",
        "format": "uuid"
      },
      "initial_intent": {
        "type": "string",
        "description": "The message that started the first run of the project."
      },
      "current_stage": {
        "type": "string",
        "description": "A stage of this definition."
      },
      "status": {
        "type": "string"
      },
      "error": {
        "type": [
          "object",
          "null"
        ]
      },
      "iteration_count": {
        "type": "integer",
        "description": "Number of rework loops so far."
      },
      "active_persona_index": {
        "type": "integer",
        "description": "Position of the persona being interviewed."
      },
      "interview_turn": {
        "type": "integer",
        "description": "Turn of the current interview."
      },
      "interviewer_stop": {
        "type": "boolean",
        "description": "Whether the interviewer ended the current interview."
      },
      "run_config": {
        "type": "object"
      },
      "elicitation_plan": {
        "anyOf": [
          {
            "$ref": "#/$defs/artifactRef"
          },
          {
            "type": "null"
          }
        ],
        "description": "The elicitation plan."
      },
      "research_corpus": {
        "anyOf": [
          {
            "$ref": "#/$defs/artifactRef"
          },
          {
            "type": "null"
          }
        ],
        "description": "The research corpus of curated documents."
      },
      "observations": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/itemRef"
        },
        "description": "Stakeholder observations mined from the corpus, each carrying verbatim evidence."
      },
      "personas": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/itemRef"
        },
        "description": "The personas."
      },
      "interview_transcripts": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/artifactRef"
        },
        "description": "One interview transcript per persona."
      },
      "raw_requirements": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/itemRef"
        },
        "description": "Raw requirements."
      },
      "analyzed_requirements": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/itemRef"
        },
        "description": "Analyzed requirements."
      },
      "latent_needs": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/itemRef"
        },
        "description": "Latent needs."
      },
      "assumptions": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/itemRef"
        },
        "description": "Assumptions."
      },
      "ambiguities": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/itemRef"
        },
        "description": "Ambiguity issues."
      },
      "conflicts": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/itemRef"
        },
        "description": "Conflicts."
      },
      "requirement_specification": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/itemRef"
        },
        "description": "Requirements of the specification."
      },
      "product_backlog": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/itemRef"
        },
        "description": "Backlog items."
      },
      "validation_report": {
        "anyOf": [
          {
            "$ref": "#/$defs/artifactRef"
          },
          {
            "type": "null"
          }
        ],
        "description": "The latest validation report."
      },
      "human_feedback": {
        "type": "array",
        "items": {
          "type": "string",
          "format": "uuid"
        },
        "description": "Ids of the decisions taken at checkpoints in this run."
      },
      "rework_directives": {
        "type": "array",
        "items": {
          "type": "string",
          "format": "uuid"
        },
        "description": "Ids of the rework directives issued in this run."
      }
    },
    "required": []
  }
}
