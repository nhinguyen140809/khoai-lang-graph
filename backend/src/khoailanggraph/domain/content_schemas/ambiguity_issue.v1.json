{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "items/ambiguity_issue/v1",
  "title": "Point to clarify",
  "description": "A statement that can be read in more than one way or lacks needed detail.",
  "x-level": "item",
  "x-kind": "ambiguity_issue",
  "x-schema-version": 1,
  "x-key-prefix": "AMB",
  "x-ui-display": "table",
  "x-ui-navigable": true,
  "x-ui-title-field": "title",
  "x-ui-list-fields": [
    "title",
    "ambiguity_type",
    "status"
  ],
  "x-ui-field-order": [
    "title",
    "description",
    "ambiguity_type",
    "ambiguous_text",
    "interpretations",
    "clarifying_question",
    "status",
    "resolution"
  ],
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "title": {
      "title": "Title",
      "type": "string",
      "description": "A short name of at most 60 characters that tells the point of the item at a glance, for example \"Find a mentor in my field\".",
      "x-ui-widget": "text"
    },
    "description": {
      "title": "Description",
      "type": "string",
      "description": "What is unclear.",
      "x-ui-widget": "textarea"
    },
    "ambiguity_type": {
      "title": "Ambiguity type",
      "type": "string",
      "x-value-list": "ambiguity_type",
      "description": "Kind of ambiguity.",
      "x-ui-widget": "select"
    },
    "ambiguous_text": {
      "title": "Ambiguous text",
      "type": "string",
      "description": "The exact wording at issue.",
      "x-ui-widget": "textarea"
    },
    "interpretations": {
      "title": "Possible interpretations",
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "The different ways in which the wording can be interpreted, one in each entry. The user settles the issue by choosing the interpretation that is meant.",
      "x-ui-widget": "list"
    },
    "clarifying_question": {
      "title": "Clarifying question",
      "type": "string",
      "description": "What to ask to resolve it.",
      "x-ui-widget": "textarea"
    },
    "status": {
      "title": "Status",
      "type": "string",
      "enum": [
        "open",
        "resolved",
        "dismissed"
      ],
      "description": "State of the issue.",
      "x-ui-widget": "badge"
    },
    "resolution": {
      "title": "Resolution",
      "type": [
        "string",
        "null"
      ],
      "description": "How it was resolved. Null while open.",
      "x-ui-widget": "textarea"
    }
  },
  "required": [
    "title",
    "description",
    "ambiguity_type",
    "ambiguous_text",
    "interpretations",
    "clarifying_question",
    "status",
    "resolution"
  ]
}
