{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "items/conflict/v1",
  "title": "Disagreement",
  "description": "Requirements, or wishes of personas, that cannot all hold.",
  "x-level": "item",
  "x-kind": "conflict",
  "x-schema-version": 1,
  "x-key-prefix": "CONF",
  "x-ui-display": "table",
  "x-ui-navigable": true,
  "x-ui-title-field": "title",
  "x-ui-list-fields": [
    "title",
    "severity",
    "status"
  ],
  "x-ui-field-order": [
    "title",
    "description",
    "conflict_type",
    "severity",
    "proposed_resolutions",
    "status",
    "resolution"
  ],
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "title": {
      "title": "Title",
      "type": "string",
      "description": "A short name of at most 60 characters that tells the point of the item at a glance, for example \"Find a mentor in my field\".",
      "x-ui-widget": "text"
    },
    "description": {
      "title": "Description",
      "type": "string",
      "description": "What conflicts.",
      "x-ui-widget": "textarea"
    },
    "conflict_type": {
      "title": "Conflict type",
      "type": "string",
      "x-value-list": "conflict_type",
      "description": "Kind of conflict.",
      "x-ui-widget": "select"
    },
    "severity": {
      "title": "Severity",
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "description": "How much it blocks the specification.",
      "x-ui-widget": "badge"
    },
    "proposed_resolutions": {
      "title": "Proposed resolutions",
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Ways to resolve it.",
      "x-ui-widget": "list"
    },
    "status": {
      "title": "Status",
      "type": "string",
      "enum": [
        "open",
        "resolved",
        "dismissed"
      ],
      "description": "State of the conflict.",
      "x-ui-widget": "badge"
    },
    "resolution": {
      "title": "Resolution",
      "type": [
        "string",
        "null"
      ],
      "description": "How it was resolved. Null while open.",
      "x-ui-widget": "textarea"
    }
  },
  "required": [
    "title",
    "description",
    "conflict_type",
    "severity",
    "proposed_resolutions",
    "status",
    "resolution"
  ]
}
