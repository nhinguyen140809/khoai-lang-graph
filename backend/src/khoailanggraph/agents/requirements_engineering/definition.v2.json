    {
      "key": "quality_category",
      "label": "Quality category",
      "values": [
        {
          "key": "performance",
          "label": "Performance",
          "description": "Response time, throughput and use of resources under the expected load."
        },
        {
          "key": "security",
          "label": "Security",
          "description": "Protection of data and functions against access and changes that are not allowed."
        },
        {
          "key": "usability",
          "label": "Usability",
          "description": "How easily the intended users learn and use the system, accessibility included."
        },
        {
          "key": "reliability",
          "label": "Reliability",
          "description": "Availability, tolerance of faults and recovery after a failure."
        },
        {
          "key": "maintainability",
          "label": "Maintainability",
          "description": "How easily the system is analyzed, changed and tested."
        },
        {
          "key": "compatibility",
          "label": "Compatibility",
          "description": "Working with other systems and sharing an environment with them."
        },
        {
          "key": "portability",
          "label": "Portability",
          "description": "Moving the system to other platforms and environments."
        }
      ]
    },
    {
      "key": "ambiguity_type",
      "label": "Ambiguity type",
      "values": [
        {
          "key": "lexical",
          "label": "Lexical",
          "description": "A word with more than one meaning."
        },
        {
          "key": "syntactic",
          "label": "Syntactic",
          "description": "A sentence structure that allows more than one reading."
        },
        {
          "key": "semantic",
          "label": "Semantic",
          "description": "A sentence whose meaning in its context is unclear."
        },
        {
          "key": "vague",
          "label": "Vague",
          "description": "A term without a measurable meaning, such as fast or easy."
        },
        {
          "key": "incomplete",
          "label": "Incomplete",
          "description": "Information needed to act on the statement is missing."
        }
      ]
    },
    {
      "key": "conflict_type",
      "label": "Conflict type",
      "values": [
        {
          "key": "between_requirements",
          "label": "Between requirements",
          "description": "Two requirements that cannot both be met."
        },
        {
          "key": "between_stakeholders",
          "label": "Between stakeholders",
          "description": "Personas who want things that cannot all hold."
        },
        {
          "key": "with_constraint",
          "label": "With a constraint",
          "description": "A requirement that breaks a stated constraint."
        }
      ]
    },
    {
      "key": "validation_category",
      "label": "Validation category",
      "values": [
        {
          "key": "elicitation",
