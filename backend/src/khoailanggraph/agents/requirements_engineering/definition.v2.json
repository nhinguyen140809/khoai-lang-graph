{
  "name": "requirements_engineering",
  "version": 2,
  "description": "Elicits requirements from a product idea: builds a research corpus of real documents, mines evidence-backed stakeholder perspectives from them, grounds the simulated stakeholder personas in that evidence, interviews them, then analyzes, specifies, backlogizes and validates the requirements, with human review at three checkpoints.",
  "entry": {
    "first_run": "planner",
    "later_runs": "intent_router",
    "pending_messages": "intent_router"
  },
  "agent_roles": [
    {
      "key": "planner",
      "label": "Planner",
      "description": "Turns the intent into an elicitation plan.",
      "prompt_version": 1
    },
    {
      "key": "corpus_builder",
      "label": "Corpus builder",
      "description": "Curates the research corpus of real documents.",
      "prompt_version": 1
    },
    {
      "key": "stakeholder_miner",
      "label": "Stakeholder miner",
      "description": "Mines stakeholder perspectives with verbatim evidence.",
      "prompt_version": 1
    },
    {
      "key": "persona_generator",
      "label": "Persona generator",
      "description": "Builds evidence-grounded personas from mined observations.",
      "prompt_version": 2
    },
    {
      "key": "interviewer",
      "label": "Interviewer",
      "description": "Asks interview questions.",
      "prompt_version": 1
    },
    {
      "key": "persona_agent",
      "label": "Persona agent",
      "description": "Answers as one persona.",
      "prompt_version": 1
    },
    {
      "key": "analyst",
      "label": "Analyst",
      "description": "Extracts and analyzes requirements.",
      "prompt_version": 1
    },
    {
      "key": "requirement_engineer",
      "label": "Requirement engineer",
      "description": "Writes the requirement specification.",
      "prompt_version": 1
    },
    {
      "key": "backlog_manager",
      "label": "Backlog manager",
      "description": "Writes the product backlog.",
      "prompt_version": 1
    },
    {
      "key": "validator",
      "label": "Validator",
      "description": "Checks the outputs and reports issues.",
      "prompt_version": 1
    },
    {
      "key": "intent_router",
      "label": "Intent router",
      "description": "Decides which node a message sent by the user should go to.",
      "prompt_version": 1
    }
  ],
