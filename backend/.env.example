# Copy to backend/.env (git-ignored). Never commit real keys.

APP_ENV=local
LOG_LEVEL=INFO
LOG_FORMAT=console

# Dev default: SQLite file under backend/data (zero setup). Point at Postgres
# with postgresql+asyncpg://user:password@localhost:5432/khoailanggraph.
# DATABASE_URL=

# LLM provider keys. The BioTuring gateway is OpenAI-compatible: set
# OPENAI_BASE_URL (and OPENAI_API_KEY) and keep the models.yaml default.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# ANTHROPIC_API_KEY=

# DEMO_MODE=true (default) runs every role on the scripted fake:demo model,
# no keys needed; false answers chat runs with the real gateway models
# through config/models.yaml.
# DEMO_MODE=false

# The interactive API docs (/docs, /openapi.json) are served outside
# production by default; set explicitly to override.
# API_DOCS_ENABLED=true

# Model overrides (README.md: Model Configuration):
# LLM__DEFAULT_MODEL=openai:glm-5.2
# LLM__ROLES__ANALYST=anthropic:claude-sonnet-5
